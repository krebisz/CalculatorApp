<Window x:Class="CalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculatorApp"
        mc:Ignorable="d"
        Title="Calculator" Height="480" Width="400"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="20" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="70*" />
        </Grid.ColumnDefinitions>

        <!-- ROW 0: Calculator Display -->
        <TextBox x:Name="DisplayTextBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" FontSize="24" Text="0" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="Black" Margin="10" />

        <!-- ROW 2: Backspace & Clear Buttons -->
        <Button Content="⌫" Grid.Row="2" Grid.Column="2" Margin="3" FontSize="18" Click="BackspaceButton_Click" />
        <Button Content="C" Grid.Row="2" Grid.Column="3" Margin="3" FontSize="18" Click="ClearButton_Click" Background="LightCyan"/>

        <!-- ROW 3: 7, 8, 9, / Buttons -->
        <Button Content="7" Grid.Row="3" Grid.Column="0" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="8" Grid.Row="3" Grid.Column="1" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="9" Grid.Row="3" Grid.Column="2" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="/" Grid.Row="3" Grid.Column="3" Margin="3" FontSize="18" Click="OperatorButton_Click" Background="LightBlue"/>

        <!-- ROW 4: 5, 6, * Buttons -->
        <Button Content="4" Grid.Row="4" Grid.Column="0" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="5" Grid.Row="4" Grid.Column="1" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="6" Grid.Row="4" Grid.Column="2" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="*" Grid.Row="4" Grid.Column="3" Margin="3" FontSize="18" Click="OperatorButton_Click" Background="LightBlue"/>

        <!-- ROW 5: 1, 2, 3, - Buttons -->
        <Button Content="1" Grid.Row="5" Grid.Column="0" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="2" Grid.Row="5" Grid.Column="1" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="3" Grid.Row="5" Grid.Column="2" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="-" Grid.Row="5" Grid.Column="3" Margin="3" FontSize="18" Click="OperatorButton_Click" Background="LightBlue"/>

        <!-- ROW 6: ",", 0, =, + Buttons -->
        <Button Content="," Grid.Row="6" Grid.Column="0" Margin="3" FontSize="18" Click="DecimalButton_Click"/>
        <Button Content="0" Grid.Row="6" Grid.Column="1" Margin="3" FontSize="18" Click="NumberButton_Click" />
        <Button Content="=" Grid.Row="6" Grid.Column="2" Margin="3" FontSize="18" Click="EqualsButton_Click" />
        <Button Content="+" Grid.Row="6" Grid.Column="3" Margin="3" FontSize="18" Click="OperatorButton_Click" Background="LightBlue"/>
        

    </Grid>
</Window>